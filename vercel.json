{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/((?!(?:messenger-embed|afterhours-bridge|afterhours-members)[.]html$).*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/messenger-embed.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors https://wildcarddev.com https://www.wildcarddev.com https://party.wildcarddev.com https://labs.wildcarddev.com https://pennysoffice.wildcarddev.com https://pennytv.wildcarddev.com"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/afterhours-bridge.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; connect-src 'self'; frame-ancestors https://wildcarddev.com https://www.wildcarddev.com; base-uri 'none'; form-action 'none'"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/nexus.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/build-assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/afterhours-members.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; media-src 'self' https:; connect-src 'self'; frame-ancestors https://wildcarddev.com https://www.wildcarddev.com; base-uri 'none'; form-action 'self'"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/oauth-protected-resource/api/pennycore-auth-demo",
      "destination": "/api/pennycore-auth-demo?action=resource"
    },
    {
      "source": "/.well-known/oauth-authorization-server/api/pennycore-auth-demo",
      "destination": "/api/pennycore-auth-demo?action=metadata"
    },
    {
      "source": "/api/pennycore-auth-demo/.well-known/oauth-authorization-server",
      "destination": "/api/pennycore-auth-demo?action=metadata"
    },
    {
      "source": "/api/pennycore-auth-demo/authorize",
      "destination": "/api/pennycore-auth-demo?action=authorize"
    },
    {
      "source": "/api/pennycore-auth-demo/token",
      "destination": "/api/pennycore-auth-demo?action=token"
    },
    {
      "source": "/api/pennycore-auth-demo/revoke",
      "destination": "/api/pennycore-auth-demo?action=revoke"
    },
    {
      "source": "/api/pennycore-auth-demo/disconnect",
      "destination": "/api/pennycore-auth-demo?action=disconnect"
    },
    {
      "source": "/api/pennycore-auth-demo/register",
      "destination": "/api/pennycore-auth-demo?action=register"
    }
  ]
}
