{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wildcard-party-stage5b-audio-signal-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-10-04",
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "AUDIO_SIGNAL_ROOM",
        "class_name": "AudioSignalRoom"
      }
    ]
  },
  "exports": {
    "AudioSignalRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
